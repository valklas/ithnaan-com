{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "ithnaan-com",
  "compatibility_date": "2026-10-06",

  "workers_dev": false,
  "preview_urls": false,

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "assets": {
    "directory": "./public"
  }
}
